<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="StbiSharp" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Graphics/Shaders/*.vert" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Graphics/Shaders/*.frag" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Audio\" />
    <Folder Include="Input\" />
    <Folder Include="GameResources\" />
    <Folder Include="FileResources\" />
    <Folder Include="Physics\" />
  </ItemGroup>
</Project>
